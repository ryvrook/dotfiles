#!/usr/bin/env bash
# Usage: ./rebuild [switch|boot|test|dry-activate]   (default: switch)
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"

action="${1:-switch}"
case "$action" in
  switch | boot | test | dry-activate | build) ;;
  *)
    echo "usage: $0 [switch|boot|test|dry-activate|build]" >&2
    exit 2
    ;;
esac

if [[ ! -e /etc/NIXOS ]]; then
  echo "this wrapper must be run on NixOS" >&2
  exit 1
fi

if [[ ! -f "$PWD/nixos/hardware-configuration.nix" ]]; then
  echo "missing nixos/hardware-configuration.nix" >&2
  echo "generate it with: sudo nixos-generate-config --show-hardware-config > nixos/hardware-configuration.nix" >&2
  exit 1
fi

export NIXOS_HARDWARE_CONFIG="$PWD/nixos/hardware-configuration.nix"
preserved_env=NIXOS_HARDWARE_CONFIG

if [[ -f "$PWD/nixos/local.nix" ]]; then
  export NIXOS_LOCAL_CONFIG="$PWD/nixos/local.nix"
  preserved_env+=,NIXOS_LOCAL_CONFIG
fi

sudo --preserve-env="$preserved_env" \
  nixos-rebuild "$action" --impure --flake "$PWD#ryv"
