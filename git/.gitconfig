[user]
	name = Aiden Smith
	email = aidensmith20@gmail.com

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true

[pull]
	rebase = true

[rebase]
	autoStash = true

[alias]
	s = status -sb
	lg = log --oneline --graph --decorate

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
